<svg viewBox="0 0 780 480" xmlns="http://www.w3.org/2000/svg" font-family="Segoe UI, Arial" xmlns:c2pa="http://c2pa.org/manifest"><metadata><c2pa:manifest></c2pa:manifest></metadata>
<rect width="780" height="480" fill="#ffffff"/>

<defs>
  <marker id="arrow" markerWidth="10" markerHeight="10" refX="8" refY="3" orient="auto" markerUnits="strokeWidth">
    <path d="M0,0 L0,6 L9,3 z" fill="#6b6b6b"/>
  </marker>
</defs>

<rect x="230" y="35" width="420" height="400" rx="10" fill="#fbfcfe" stroke="#3a6ea5" stroke-width="2"/><text x="440" y="60" text-anchor="middle" font-size="15" font-weight="700" font-family="Segoe UI, Arial" fill="#1c2b3a">Sistema de Agendamento da Clínica</text>
<line x1="112" y1="250" x2="245" y2="210" stroke="#2d3142" stroke-width="1.8"/><line x1="112" y1="250" x2="445" y2="210" stroke="#2d3142" stroke-width="1.8"/><line x1="112" y1="250" x2="245" y2="320" stroke="#2d3142" stroke-width="1.8"/><line x1="112" y1="250" x2="445" y2="320" stroke="#2d3142" stroke-width="1.8"/>
    <line x1="360" y1="186" x2="400" y2="132" stroke="#6b6b6b" stroke-width="1.6" stroke-dasharray="6,4" marker-end="url(#arrow)"/>
    <text x="380.0" y="151.0" text-anchor="middle" font-size="11" font-style="italic" font-family="Segoe UI, Arial" fill="#6b6b6b">«include»</text>
    
    <line x1="520" y1="186" x2="480" y2="132" stroke="#6b6b6b" stroke-width="1.6" stroke-dasharray="6,4" marker-end="url(#arrow)"/>
    <text x="500.0" y="151.0" text-anchor="middle" font-size="11" font-style="italic" font-family="Segoe UI, Arial" fill="#6b6b6b">«include»</text>
    
    <line x1="530" y1="239" x2="455" y2="379" stroke="#6b6b6b" stroke-width="1.6" stroke-dasharray="6,4" marker-end="url(#arrow)"/>
    <text x="492.5" y="301.0" text-anchor="middle" font-size="11" font-style="italic" font-family="Segoe UI, Arial" fill="#6b6b6b">«include»</text>
    
    <line x1="530" y1="349" x2="475" y2="384" stroke="#6b6b6b" stroke-width="1.6" stroke-dasharray="6,4" marker-end="url(#arrow)"/>
    <text x="502.5" y="358.5" text-anchor="middle" font-size="11" font-style="italic" font-family="Segoe UI, Arial" fill="#6b6b6b">«include»</text>
    

    <ellipse cx="440" cy="110" rx="95" ry="32" fill="#eaf2ff" stroke="#3a6ea5" stroke-width="2"/>
    <text x="440" y="110" text-anchor="middle" font-size="12.5" font-family="Segoe UI, Arial" fill="#1c2b3a">Autenticar-se</text>

    

    <ellipse cx="340" cy="210" rx="105" ry="34" fill="#eaf2ff" stroke="#3a6ea5" stroke-width="2"/>
    <text x="340" y="202" text-anchor="middle" font-size="12.5" font-family="Segoe UI, Arial" fill="#1c2b3a">Visualizar</text>
<text x="340" y="218" text-anchor="middle" font-size="12.5" font-family="Segoe UI, Arial" fill="#1c2b3a">Agendamentos</text>

    

    <ellipse cx="540" cy="210" rx="105" ry="34" fill="#eaf2ff" stroke="#3a6ea5" stroke-width="2"/>
    <text x="540" y="202" text-anchor="middle" font-size="12.5" font-family="Segoe UI, Arial" fill="#1c2b3a">Confirmar</text>
<text x="540" y="218" text-anchor="middle" font-size="12.5" font-family="Segoe UI, Arial" fill="#1c2b3a">Agendamento</text>

    

    <ellipse cx="340" cy="320" rx="105" ry="34" fill="#eaf2ff" stroke="#3a6ea5" stroke-width="2"/>
    <text x="340" y="320" text-anchor="middle" font-size="12.5" font-family="Segoe UI, Arial" fill="#1c2b3a">Cancelar Agendamento</text>

    

    <ellipse cx="540" cy="320" rx="105" ry="34" fill="#eaf2ff" stroke="#3a6ea5" stroke-width="2"/>
    <text x="540" y="312" text-anchor="middle" font-size="12.5" font-family="Segoe UI, Arial" fill="#1c2b3a">Reagendar</text>
<text x="540" y="328" text-anchor="middle" font-size="12.5" font-family="Segoe UI, Arial" fill="#1c2b3a">Atendimento</text>

    

    <ellipse cx="440" cy="410" rx="115" ry="36" fill="#eaf2ff" stroke="#3a6ea5" stroke-width="2"/>
    <text x="440" y="402" text-anchor="middle" font-size="12.5" font-family="Segoe UI, Arial" fill="#1c2b3a">Notificar Cliente</text>
<text x="440" y="418" text-anchor="middle" font-size="12.5" font-family="Segoe UI, Arial" fill="#1c2b3a">(e-mail/telefone)</text>

    

    <g stroke="#2d3142" stroke-width="2" fill="none">
      <circle cx="100" cy="250" r="12.0" fill="#ffffff"/>
      <line x1="100" y1="262.0" x2="100" y2="292.0"/>
      <line x1="84.0" y1="270.0" x2="116.0" y2="270.0"/>
      <line x1="100" y1="292.0" x2="86.0" y2="317.0"/>
      <line x1="100" y1="292.0" x2="114.0" y2="317.0"/>
    </g>
    <text x="100" y="335.0" text-anchor="middle" font-size="13" font-family="Segoe UI, Arial" fill="#2d3142" font-weight="600">Administrador</text>
    
<text x="390.0" y="468" text-anchor="middle" font-size="12" fill="#8a8a8a">Diagrama de Caso de Uso — Gerenciamento de Agendamentos (RF11)</text>
