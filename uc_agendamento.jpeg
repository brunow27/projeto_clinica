<svg viewBox="0 0 900 480" xmlns="http://www.w3.org/2000/svg" font-family="Segoe UI, Arial" xmlns:c2pa="http://c2pa.org/manifest"><metadata><c2pa:manifest></c2pa:manifest></metadata>
<rect width="900" height="480" fill="#ffffff"/>

<defs>
  <marker id="arrow" markerWidth="10" markerHeight="10" refX="8" refY="3" orient="auto" markerUnits="strokeWidth">
    <path d="M0,0 L0,6 L9,3 z" fill="#6b6b6b"/>
  </marker>
</defs>

<rect x="230" y="35" width="480" height="410" rx="10" fill="#fbfcfe" stroke="#3a6ea5" stroke-width="2"/><text x="470" y="60" text-anchor="middle" font-size="15" font-weight="700" font-family="Segoe UI, Arial" fill="#1c2b3a">Sistema de Agendamento da Clínica</text>
<line x1="102" y1="250" x2="310" y2="130" stroke="#2d3142" stroke-width="1.8"/>
    <line x1="390" y1="151" x2="355" y2="198" stroke="#6b6b6b" stroke-width="1.6" stroke-dasharray="6,4" marker-end="url(#arrow)"/>
    <text x="372.5" y="166.5" text-anchor="middle" font-size="11" font-style="italic" font-family="Segoe UI, Arial" fill="#6b6b6b">«include»</text>
    
    <line x1="515" y1="135" x2="550" y2="193" stroke="#6b6b6b" stroke-width="1.6" stroke-dasharray="6,4" marker-end="url(#arrow)"/>
    <text x="532.5" y="156.0" text-anchor="middle" font-size="11" font-style="italic" font-family="Segoe UI, Arial" fill="#6b6b6b">«include»</text>
    
    <line x1="495" y1="324" x2="430" y2="151" stroke="#6b6b6b" stroke-width="1.6" stroke-dasharray="6,4" marker-end="url(#arrow)"/>
    <text x="462.5" y="229.5" text-anchor="middle" font-size="11" font-style="italic" font-family="Segoe UI, Arial" fill="#6b6b6b">«extend»</text>
    <line x1="816" y1="375" x2="605" y2="360" stroke="#2d3142" stroke-width="1.8"/>

    <ellipse cx="420" cy="120" rx="110" ry="36" fill="#eaf2ff" stroke="#3a6ea5" stroke-width="2"/>
    <text x="420" y="112" text-anchor="middle" font-size="12.5" font-family="Segoe UI, Arial" fill="#1c2b3a">Solicitar</text>
<text x="420" y="128" text-anchor="middle" font-size="12.5" font-family="Segoe UI, Arial" fill="#1c2b3a">Agendamento</text>

    

    <ellipse cx="345" cy="230" rx="100" ry="32" fill="#eaf2ff" stroke="#3a6ea5" stroke-width="2"/>
    <text x="345" y="222" text-anchor="middle" font-size="12.5" font-family="Segoe UI, Arial" fill="#1c2b3a">Selecionar</text>
<text x="345" y="238" text-anchor="middle" font-size="12.5" font-family="Segoe UI, Arial" fill="#1c2b3a">Procedimento</text>

    

    <ellipse cx="590" cy="220" rx="115" ry="42" fill="#eaf2ff" stroke="#3a6ea5" stroke-width="2"/>
    <text x="590" y="204" text-anchor="middle" font-size="12.5" font-family="Segoe UI, Arial" fill="#1c2b3a">Informar Dados de</text>
<text x="590" y="220" text-anchor="middle" font-size="12.5" font-family="Segoe UI, Arial" fill="#1c2b3a">Contato (nome,</text>
<text x="590" y="236" text-anchor="middle" font-size="12.5" font-family="Segoe UI, Arial" fill="#1c2b3a">telefone, e-mail)</text>

    

    <ellipse cx="500" cy="360" rx="115" ry="36" fill="#eaf2ff" stroke="#3a6ea5" stroke-width="2"/>
    <text x="500" y="352" text-anchor="middle" font-size="12.5" font-family="Segoe UI, Arial" fill="#1c2b3a">Confirmar / Recusar</text>
<text x="500" y="368" text-anchor="middle" font-size="12.5" font-family="Segoe UI, Arial" fill="#1c2b3a">Agendamento</text>

    

    <g stroke="#2d3142" stroke-width="2" fill="none">
      <circle cx="90" cy="250" r="12.0" fill="#ffffff"/>
      <line x1="90" y1="262.0" x2="90" y2="292.0"/>
      <line x1="74.0" y1="270.0" x2="106.0" y2="270.0"/>
      <line x1="90" y1="292.0" x2="76.0" y2="317.0"/>
      <line x1="90" y1="292.0" x2="104.0" y2="317.0"/>
    </g>
    <text x="90" y="335.0" text-anchor="middle" font-size="13" font-family="Segoe UI, Arial" fill="#2d3142" font-weight="600">Visitante</text>
    

    <g stroke="#2d3142" stroke-width="2" fill="none">
      <circle cx="830" cy="380" r="12.0" fill="#ffffff"/>
      <line x1="830" y1="392.0" x2="830" y2="422.0"/>
      <line x1="814.0" y1="400.0" x2="846.0" y2="400.0"/>
      <line x1="830" y1="422.0" x2="816.0" y2="447.0"/>
      <line x1="830" y1="422.0" x2="844.0" y2="447.0"/>
    </g>
    <text x="830" y="465.0" text-anchor="middle" font-size="13" font-family="Segoe UI, Arial" fill="#2d3142" font-weight="600">Administrador</text>
    
<text x="450.0" y="468" text-anchor="middle" font-size="12" fill="#8a8a8a">Diagrama de Caso de Uso — Agendamento de Atendimento (RF06, RF07)</text>
